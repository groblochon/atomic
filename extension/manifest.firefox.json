{
  "manifest_version": 3,
  "name": "Atomic Web Clipper",
  "version": "1.0.0",
  "description": "Capture web content to Atomic note-taking app",

  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "storage",
    "notifications",
    "alarms"
  ],

  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://localhost/*",
    "https://127.0.0.1/*",
    "https://*/*"
  ],

  "options_page": "options/options.html",

  "background": {
    "scripts": ["background/service-worker.js"],
    "type": "module"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "commands": {
    "capture-page": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "Save current page to Atomic"
    },
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+A",
        "mac": "Alt+Shift+A"
      },
      "description": "Open Atomic Web Clipper popup"
    }
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "clipper@atomic.local",
      "strict_min_version": "109.0"
    }
  }
}
